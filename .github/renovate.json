{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>trim21/renovate-config",
    "github>trim21/renovate-config:python",
    "github>trim21/renovate-config:app"
  ],
  "rebaseWhen": "conflicted",
  "labels": ["dependencies", "ci:auto-merge"],
  "customManagers": [
    {
      "customType": "jsonata",
      "managerFilePatterns": ["packages/*/recipe.yaml"],
      "fileFormat": "yaml",
      "matchStrings": [
        "$exists(context.github_repo) ? {\"packageName\": context.github_repo, \"currentValue\": context.version} : []"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?:v)?(?<version>.+)$"
    }
  ]
}
